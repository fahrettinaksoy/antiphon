{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["electron-vite/node", "node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@schema/*": ["packages/schema/src/*"],
      "@runtime/*": ["packages/runtime/src/*"]
    }
  },
  "include": [
    "electron.vite.config.*",
    "electron/main/**/*",
    "electron/preload/**/*",
    "shared/**/*",
    "packages/schema/src/**/*",
    "packages/runtime/src/**/*",
    "packages/cli/**/*"
  ]
}
