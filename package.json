{
  "name": "antiphon",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Git-native, hesapsız, masaüstü API client (REST/GraphQL/WebSocket) — Vue 3 + Tauri + Vuetify (Material Design)",
  "author": "Antiphon",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,vue}": "eslint --cache --fix",
    "*.{ts,js,vue,json,md,yml,yaml,scss,css,html}": "prettier --write"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@faker-js/faker": "^10.5.0",
    "@mdi/font": "^7.4.47",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@vueuse/core": "^12.0.0",
    "cm6-graphql": "^0.2.1",
    "codemirror": "^6.0.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "graphql": "^16.14.2",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.4.0",
    "marked": "^18.0.6",
    "nanoid": "^5.0.9",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.1.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.5.0",
    "vuetify": "^3.12.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@tauri-apps/cli": "^2",
    "@types/diff": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
