{
  "name": "antiphon",
  "version": "0.1.0",
  "description": "Git-native, hesapsız, masaüstü API client (REST/GraphQL/WebSocket) — Vue 3 + Electron + Vuetify (Material Design)",
  "main": "./out/main/index.js",
  "author": "Antiphon",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.vue",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@faker-js/faker": "^10.5.0",
    "@mdi/font": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vueuse/core": "^12.0.0",
    "chokidar": "^4.0.3",
    "cm6-graphql": "^0.2.1",
    "codemirror": "^6.0.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.11",
    "fastify": "^5.9.0",
    "got": "^14.4.5",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.0.8",
    "hpagent": "^1.2.0",
    "isomorphic-git": "^1.38.6",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.4.0",
    "marked": "^18.0.5",
    "nanoid": "^5.0.9",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.1.3",
    "tough-cookie": "^5.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.5.0",
    "vuetify": "^3.12.9",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "sass": "^1.101.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
