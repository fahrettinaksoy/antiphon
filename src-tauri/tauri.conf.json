{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antiphon",
  "version": "0.1.0",
  "identifier": "com.stackvo.antiphon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Antiphon",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Antiphon",
    "copyright": "© 2026 Antiphon",
    "shortDescription": "Git-native masaüstü API client",
    "longDescription": "Antiphon - Git-native, hesapsız, yerel-önce masaüstü API client. REST, GraphQL, WebSocket ve MCP istekleri; çalışma alanları git ile sürümlenir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
